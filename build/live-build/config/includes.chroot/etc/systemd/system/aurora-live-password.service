[Unit]
Description=AURORA live session credentials
Documentation=https://github.com/AARUTO347/aurora-os
Before=lightdm.service
After=local-fs.target systemd-sysusers.service
ConditionPathExists=/usr/sbin/chpasswd

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aurora-live-password
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
