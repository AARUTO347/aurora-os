#!/bin/sh
# Launch the AURORA browser (Falkon, Chromium/QtWebEngine engine).
#
# The live Xorg session has no hardware GL and does not grant the Chromium
# sandbox its own namespaces, so run with software rendering and the sandbox
# disabled. Epiphany/WebKit aborts in this environment (KI-032).
export HOME="${HOME:-/home/ubuntu}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export QT_QPA_PLATFORM=xcb
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-gpu-compositing --disable-dev-shm-usage --single-process"
exec falkon "$@"
