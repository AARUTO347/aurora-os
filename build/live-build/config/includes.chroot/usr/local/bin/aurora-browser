#!/bin/sh
# Launch the AURORA browser (Mozilla Firefox, official tarball in /opt/firefox).
#
# Firefox renders with its own software WebRender and works without a GPU,
# unlike WebKit/QtWebEngine in this live Xorg session (KI-032). The bundled
# NSS must win over the distro copy, hence LD_LIBRARY_PATH.
export HOME="${HOME:-/home/ubuntu}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export GDK_BACKEND=x11
export MOZ_ENABLE_WAYLAND=0
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_CRASHREPORTER_DISABLE=1
export LIBGL_ALWAYS_SOFTWARE=1
export LD_LIBRARY_PATH="/opt/firefox${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /opt/firefox/firefox "$@"
