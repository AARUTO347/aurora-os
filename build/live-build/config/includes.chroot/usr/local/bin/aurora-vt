#!/bin/sh
# Fallback VT activation: LightDM starts X with -novtswitch in some
# configurations, which leaves the greeter on an inactive VT (KI-027).
set -u

i=0
while [ "$i" -lt 60 ]; do
	vt=$(ps -eo args= 2>/dev/null |
		sed -n 's/.*Xorg .*[[:space:]]vt\([0-9][0-9]*\).*/\1/p' | head -n1)
	if [ -n "${vt:-}" ]; then
		if [ "$(fgconsole 2>/dev/null || echo -1)" != "$vt" ]; then
			chvt "$vt" 2>/dev/null || true
		fi
		if [ "$(fgconsole 2>/dev/null || echo -1)" = "$vt" ]; then
			logger -t aurora "AURORA_VT_READY vt=$vt"
			exit 0
		fi
	fi
	i=$((i + 1))
	sleep 1
done

logger -t aurora "AURORA_VT_NOT_CONFIRMED"
exit 0
