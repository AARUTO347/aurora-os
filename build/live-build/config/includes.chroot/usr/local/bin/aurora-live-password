#!/bin/sh
# casper deletes the live user's password. Without this the greeter would
# reject the account once autologin is disabled.
set -eu

USER_NAME=${AURORA_LIVE_USER:-ubuntu}
USER_PASS=${AURORA_LIVE_PASSWORD:-aurora}

id "$USER_NAME" >/dev/null 2>&1 || exit 0
printf '%s:%s\n' "$USER_NAME" "$USER_PASS" | /usr/sbin/chpasswd
passwd -u "$USER_NAME" >/dev/null 2>&1 || true
logger -t aurora "AURORA_LIVE_CREDENTIALS_READY user=$USER_NAME"
