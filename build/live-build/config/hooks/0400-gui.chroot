#!/bin/sh
set -eu

# Boot to the graphical login and start LightDM. Autologin is disabled by
# /etc/lightdm/lightdm.conf.d/90-aurora.conf, which is read after the keys
# casper injects into lightdm.conf at boot.
systemctl set-default graphical.target
systemctl enable lightdm.service
# Shared live-session credentials are a TEST-profile convenience only. The
# release profile (build-release-iso.sh) removes this service file, so only
# enable it when it is actually staged. Production must not provision a common
# password; scripts/release-gate.sh refuses any image that still carries it.
if [ -e /etc/systemd/system/aurora-live-password.service ]; then
	systemctl enable aurora-live-password.service
fi
systemctl enable aurora-identity.service
systemctl enable aurora-vt.service

# Fail the build early if the staged login/session configuration is incomplete.
for f in \
	/etc/lightdm/lightdm.conf.d/50-aurora.conf \
	/etc/lightdm/lightdm.conf.d/90-aurora.conf \
	/etc/lightdm/lightdm-gtk-greeter.conf.d/50-aurora.conf \
	/usr/share/aurora/wallpaper.png \
	/usr/share/aurora/login-logo.svg \
	/usr/share/aurora/login-logo.png \
	/usr/share/aurora/credits.txt \
	/usr/local/bin/aurora-display-setup \
	/usr/local/bin/aurora-session-setup \
	/usr/local/bin/aurora-identity \
	/usr/local/bin/aurora-vt \
	/usr/local/bin/aurora-session-action \
	/usr/local/bin/aurora-system-info \
	/usr/local/bin/aurora-diagnostics \
	/usr/local/bin/aurora-wallpaper \
	/etc/systemd/system/aurora-identity.service \
	/etc/systemd/system/aurora-vt.service \
	/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml \
	/etc/xdg/autostart/aurora-wallpaper.desktop \
	/etc/xdg/autostart/aurora-session.desktop \
	/etc/skel/Desktop/aurora-logout.desktop \
	/etc/skel/Desktop/aurora-switch-user.desktop \
	/etc/skel/Desktop/aurora-lock.desktop \
	/etc/skel/Desktop/aurora-browser.desktop \
	/etc/skel/Desktop/aurora-system-info.desktop \
	/etc/skel/Desktop/aurora-diagnostics.desktop \
	/usr/share/applications/aurora-browser.desktop \
	/usr/share/applications/aurora-settings.desktop \
	/usr/share/applications/aurora-apps.desktop; do
	if [ ! -e "$f" ]; then
		echo "0400-gui.chroot: missing $f" >&2
		exit 1
	fi
done

chmod 0755 /usr/local/bin/aurora-display-setup \
	/usr/local/bin/aurora-session-setup \
	/usr/local/bin/aurora-identity \
	/usr/local/bin/aurora-vt \
	/usr/local/bin/aurora-session-action \
	/usr/local/bin/aurora-system-info \
	/usr/local/bin/aurora-diagnostics \
	/usr/local/bin/aurora-wallpaper
chmod 0755 /etc/skel/Desktop/*.desktop
chmod 0644 /usr/share/applications/aurora-*.desktop
chmod 0644 /etc/xdg/autostart/aurora-session.desktop \
	/etc/systemd/system/aurora-identity.service \
	/etc/systemd/system/aurora-vt.service \
	/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml

# Test-profile shared-credential helpers: validate and chmod only when staged.
if [ -e /etc/systemd/system/aurora-live-password.service ]; then
	for f in \
		/usr/local/bin/aurora-live-password \
		/etc/systemd/system/aurora-live-password.service; do
		if [ ! -e "$f" ]; then
			echo "0400-gui.chroot: missing $f" >&2
			exit 1
		fi
	done
	chmod 0755 /usr/local/bin/aurora-live-password
	chmod 0644 /etc/systemd/system/aurora-live-password.service
fi

# The greeter is only usable if it can read the account list.
systemctl enable accounts-daemon.service
install -d -o lightdm -g lightdm -m 0755 /var/lib/lightdm/data

# Fast boot for an offline live image: units that wait for a network or a
# checksum file used to stall the boot for minutes before giving up.
install -d /etc/systemd/system.conf.d
cat > /etc/systemd/system.conf.d/aurora-timeouts.conf <<'CONF'
[Manager]
DefaultTimeoutStartSec=30s
DefaultTimeoutStopSec=20s
CONF

for u in networkd-dispatcher.service casper-md5check.service e2scrub_reap.service \
	grub-initrd-fallback.service grub2-common.service ua-reboot-cmds.service \
	ubuntu-advantage.service systemd-networkd-wait-online.service \
	apt-daily.timer apt-daily-upgrade.timer motd-news.timer; do
	systemctl disable "$u" >/dev/null 2>&1 || true
	systemctl mask "$u" >/dev/null 2>&1 || true
done

# casper runs apt update at boot; fail quickly when the guest is offline.
cat > /etc/apt/apt.conf.d/99-aurora-live <<'CONF'
Acquire::http::Timeout "3";
Acquire::https::Timeout "3";
Acquire::Retries "0";
CONF
